# Filled in by ./scripts/setup.sh
SANITY_PROJECT_ID=
SANITY_DATASET=production
STRIPE_SECRET_KEY=
SANITY_WRITE_TOKEN=
# local: from `stripe listen`, production: set by the wizard
STRIPE_WEBHOOK_SECRET=
# Doručení na adresu, whole CZK (default 99)
DELIVERY_PRICE_CZK=99
# Odběrní místo shown for Osobní odběr
PICKUP_PLACE=
# E-maily (Resend). Without a verified domain Resend only delivers to the account's own address.
RESEND_API_KEY=
# Obchodník: receives Nová objednávka upozornění; also the contact in every e-mail footer
MERCHANT_EMAIL=
# Sender (default: Kalendáře <onboarding@resend.dev>)
EMAIL_FROM=
